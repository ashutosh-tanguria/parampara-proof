# Copy to .env. No API keys are needed; there is no paid AI service.
PORT=8000
LOG_LEVEL=INFO

# Where the model files live (default: ./backend)
MODEL_DIR=backend

# Uploads: stored under random IDs and deleted after the TTL
UPLOAD_DIR=backend/uploads
UPLOAD_TTL_HOURS=24
MAX_UPLOAD_MB=10

# Comma-separated list of allowed browser origins (no wildcard)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Requests per minute per IP on /api/analyze and /api/chat
RATE_LIMIT_PER_MIN=20

# Hugging Face cache for the CLIP weights (~600 MB, downloaded on first start).
# Set HF_HUB_OFFLINE=1 once the weights are cached to run fully offline.
HF_HOME=.hf-cache
HF_HUB_OFFLINE=0

# Accounts, videos, marketplace and messages (SQLite file and uploads live here)
DATA_DIR=backend/data
# Secret used to sign login cookies. The built-in default is for local demos ONLY: set your own for anything public.
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when served over HTTPS so the login cookie is marked Secure
COOKIE_SECURE=0
SESSION_DAYS=7
